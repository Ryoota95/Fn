  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <!-- CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  


<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
  <div class="container">
    <a class="navbar-brand fw-bold" href="#">
      <img style="width: 50px;" src="https://png.pngtree.com/png-vector/20220313/ourmid/pngtree-se-initial-letter-logo-for-corporate-business-identity-vector-png-image_29906606.jpg" alt="">
    </a>

    <ul class="navbar-nav ms-auto">
      <li class="nav-item"><a class="nav-link" href="#tech-stack">Tech Stack</a></li>
      <li class="nav-item"><a class="nav-link" href="#experience">Experience</a></li>
      <li class="nav-item"><a class="nav-link" href="#project">Projects</a></li>
     
          <a href="#" class="btn btn-success me-2"><i class="fa-brands fa-whatsapp" style="margin-right: 5px;"></i>Let's Talk</a>
          <a href="#" class="btn btn-dark"><i class="fa-solid fa-file-arrow-down" style="margin-right: 5px;"></i>Download CV</a>
          
      
    </ul>
    <button class="dark-btn" id="darkToggle">🌙</button>

  </div>
</nav>

<section class="hero-section">
  <div class="container">
    <div class="row align-items-center">

      <div class="col-md-5 text-center">
        <img src="/img/ray.jpg" class="profile-img" alt="profile">
      </div>

      <div class="col-md-7">
        <h1 class="p">
          Hi, I'm <span class="text-primary">{{name}}</span> 👋
        </h1>

        <h5 class="p">{{role}}</h5>

        <p class="p">
         In 3 months of learning coding,
         I have made 2 projects from camp and one is personal.
        </p>

        <p class="p">
          Even though I'm just learning,
          I've created a purchasing system starting from the user to the database to the final payment.
        </p>

        <p class="p">
          📍 {{location}} <br>
          {{#if available}}
            🟢 Available for new projects
          {{else}}
            🔴 Not available
          {{/if}}
        </p>

        <div class="mt-4">
          <a href="#" class="btn btn-success me-2"><i class="fa-brands fa-whatsapp" style="margin-right: 5px;"></i>Let's Talk</a>
          <a href="#" class="btn btn-dark"><i class="fa-solid fa-file-arrow-down" style="margin-right: 5px;"></i>Download CV</a>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Tech Stack Carousel -->
<section class="tech-stack-section" id="tech-stack">
  <div class="container">

    <h3 class="fw-bold mb-4">
      Tech Stack - <span>Tools I Use Everyday</span>
    </h3>

    <div id="techStackCarousel" class="carousel slide" data-bs-ride="carousel">
      <div class="carousel-inner text-center">

        <!-- Slide 1 -->
        <div class="carousel-item active">
          <div class="row justify-content-center gy-4">
            <div class="col-4 col-md-2">
              <img src="/img/postgresql.svg" class="tech-icon">
              <p class="p">PostgreSQL</p>
            </div>
            <div class="col-4 col-md-2">
              <img src="/img/mongodb.svg" class="tech-icon">
              <p class="p">MongoDB</p>
            </div>
            <div class="col-4 col-md-2">
              <img src="/img/dotnet.svg" class="tech-icon">
              <p class="p">.NET</p>
            </div>
            <div class="col-4 col-md-2">
              <img src="/img/unity.svg" class="tech-icon">
              <p class="p">Unity</p>
            </div>
            <div class="col-4 col-md-2">
              <img src="/img/react.svg" class="tech-icon">
              <p class="p">React</p>
            </div>
            <div class="col-4 col-md-2">
              <img src="/img/nextdotjs.svg" class="tech-icon">
              <p class="p">Next.js</p>
            </div>
          </div>
        </div>

        <!-- Slide 2 -->
        <div class="carousel-item">
          <div class="row justify-content-center gy-4">
            <div class="col-4 col-md-2">
              <img src="/img/tailwindcss.svg" class="tech-icon">
              <p class="p">Tailwind</p>
            </div>
            <div class="col-4 col-md-2">
              <img src="/img/nodedotjs.svg" class="tech-icon">
              <p class="p">Node.js</p>
            </div>
            <div class="col-4 col-md-2">
              <img src="/img/express.svg" class="tech-icon">
              <p class="p">Express</p>
            </div>
          </div>
        </div>

      </div>

    <div
  id="techStackCarousel"
  class="carousel slide"
  data-bs-ride="carousel"
  data-bs-interval="3000">

  <div class="carousel-inner">
    
  </div>

</div>

    </div>

  </div>
</section>

